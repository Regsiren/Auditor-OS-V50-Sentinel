{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thohatventures.com/schemas/sent-attestation-v1.0.json",
  "title": "Sentinel .sent Attestation Evidence Bag — Dual-Pillar Schema v1.0",
  "description": "Investor Brief Dual-Pillar .sent schema v1.0. Exactly four top-level blocks: attestation_header, thermodynamic_state_vector, execution_context, cryptographic_attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_header",
    "thermodynamic_state_vector",
    "execution_context",
    "cryptographic_attestation"
  ],
  "properties": {
    "attestation_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "timestamp_utc_ms",
        "sequence_step",
        "prev_bag_hash",
        "crypto_seed_matrix"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "const": "THOHAT-V50-SENTINEL/1.0"
        },
        "timestamp_utc_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "UTC minting epoch milliseconds."
        },
        "sequence_step": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic reasoning / telemetry step index for this bag."
        },
        "prev_bag_hash": {
          "type": ["string", "null"],
          "pattern": "^([a-f0-9]{64})?$",
          "description": "SHA-256 hex of the prior bag's canonical_row_hash, or null for genesis."
        },
        "crypto_seed_matrix": {
          "type": "object",
          "description": "Named seed / salt identifiers (no raw secret material).",
          "required": ["salt_id"],
          "properties": {
            "salt_id": { "type": "string" },
            "doi_reference": { "type": "string" },
            "zone_or_session_id": { "type": "string" }
          }
        }
      }
    },
    "thermodynamic_state_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_coordinate_omega",
        "sub_resolution_jitter_j_tau",
        "rolling_fatigue_fc",
        "phase_boundary_state"
      ],
      "properties": {
        "state_coordinate_omega": {
          "type": "number",
          "minimum": 0,
          "description": "Accumulated State Uncertainty Coordinate Ω_t (AI) or Φ analogue."
        },
        "sub_resolution_jitter_j_tau": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute kinetic / orthogonal acceleration |J_τ| at mint time."
        },
        "rolling_fatigue_fc": {
          "type": "number",
          "minimum": 0,
          "description": "Rolling T-30 Fatigue Coefficient F_c."
        },
        "phase_boundary_state": {
          "type": "string",
          "enum": [
            "Nominal / Homeostatic (< 0.07 Ω)",
            "Metastable Impairment (0.07 to 0.19 Ω)",
            "Topological Veto (≥ 0.19 Ω)"
          ]
        }
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_identifier",
        "process_id",
        "layer_depth_index",
        "hardware_node_id"
      ],
      "properties": {
        "model_identifier": {
          "type": "string",
          "description": "Frontier model checkpoint ID, physical asset tag, or runtime label."
        },
        "process_id": {
          "type": "string",
          "description": "OS process / session identifier."
        },
        "layer_depth_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Residual block index (0-based) or 0 for physical streams."
        },
        "hardware_node_id": {
          "type": "string",
          "description": "Host / accelerator node identifier."
        }
      }
    },
    "cryptographic_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_row_hash",
        "signature_algorithm",
        "digital_signature"
      ],
      "properties": {
        "canonical_row_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the canonical JSON of the three unsigned blocks."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": ["Ed25519", "HMAC-SHA256-FALLBACK"]
        },
        "digital_signature": {
          "type": "string",
          "minLength": 32,
          "description": "Hex-encoded Ed25519 signature over canonical_row_hash, or HMAC-SHA256 fallback."
        },
        "public_key_hex": {
          "type": ["string", "null"],
          "description": "Optional Ed25519 public key (hex) when signature_algorithm is Ed25519."
        }
      }
    }
  }
}
